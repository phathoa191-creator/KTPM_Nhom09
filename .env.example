# Server đọc .env; chỉ mở pool khi gọi API database.
# Chọn một: DB_PORT (cổng cố định thực tế) HOẶC DB_INSTANCE=SQLEXPRESS.
# Để dùng DB_PORT, xóa giá trị DB_INSTANCE. Không mặc định Express ở cổng 1433.
PORT=3000
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_DATABASE=CellphoneS_Testing
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
